{
  "name": "saferoles",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --import tsx --test \"tests/*.test.ts\"",
    "test:rendered": "node --test \"tests/*.test.mjs\"",
    "test": "npm run typecheck && npm run lint && npm run test:unit && npm run build && npm run test:rendered",
    "db:generate": "tsx scripts/generate-sql.ts",
    "icons": "tsx scripts/generate-icons.ts",
    "lint": "eslint . --max-warnings 0 --ignore-pattern dist --ignore-pattern .next --ignore-pattern work"
  },
  "dependencies": {
    "@gnosis-guild/zodiac-core": "^4.3.0",
    "@safe-global/safe-apps-sdk": "^9.1.0",
    "drizzle-orm": "^0.45.2",
    "ethers": "^6.15.0",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zodiac-roles-sdk": "^3.4.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.48.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "^8.1.5",
    "wrangler": "^4.115.0"
  },
  "overrides": {
    "next": {
      "sharp": "0.35.3"
    }
  },
  "type": "module"
}
