# Vinext consumes React's RSC runtime through Vite rather than Webpack, although
# react-server-dom-webpack still declares Webpack as a peer. Rolldown's optional
# wasm fallback also has incompatible optional peer ranges. Native Vite builds
# use neither peer path, so npm 11 must preserve this lockfile's legacy-peer
# resolution for deterministic clean installs.
legacy-peer-deps=true
